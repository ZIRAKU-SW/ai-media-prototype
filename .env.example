SUPABASE_URL=https://wqlelowutbxplrzforcc.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxx   # フロントエンド用（公開可）
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxx # サーバーサイド専用（絶対公開禁止）
SUPABASE_DB_PASSWORD=xxxxxxxxxx                # DB直接接続用
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_ID.supabase.co:5432/postgres

# ── AI開発コンソール（/admin/dev）────────────────────────
CURSOR_API_KEY=key_xxxxxxxxxx                  # Cursor API キー（必須・GCP VM バックエンド側）
DEV_CONSOLE_PROJECT_ROOT=/absolute/path/to/ai-media-prototype
DEV_CONSOLE_PYTHON_MODULE=ai_media_agent.dev_agent
DEV_CONSOLE_PASSWORD=your-secret-token         # 推奨: UI トークン欄 + x-dev-token ヘッダー
# CURSOR_SDK_MODEL=composer-2.5                  # 任意: composer-2.5-fast は API 非対応

# ── Vercel 本番のみ（GCP VM バックエンドへプロキシ）──────
