# AIビジネスメディア X 自動投稿（JST / Asia-Tokyo）
# 設置: crontab -e
# パスは VM 上の実際のリポジトリに合わせて変更

CRON_TZ=Asia/Tokyo

# 朝の通勤 7:30
30 7 * * * cd /home/powerpass7/ai-media-prototype && /usr/bin/npm run x:post -- commute_morning >> /var/log/x-post.log 2>&1

# 昼休み 12:00
0 12 * * * cd /home/powerpass7/ai-media-prototype && /usr/bin/npm run x:post -- lunch >> /var/log/x-post.log 2>&1

# 夕方帰宅 18:00
0 18 * * * cd /home/powerpass7/ai-media-prototype && /usr/bin/npm run x:post -- commute_evening >> /var/log/x-post.log 2>&1

# 夜・寝る前 22:00
0 22 * * * cd /home/powerpass7/ai-media-prototype && /usr/bin/npm run x:post -- bedtime >> /var/log/x-post.log 2>&1

# 米国の朝ニュース 23:00（ET 9:00 頃）
0 23 * * * cd /home/powerpass7/ai-media-prototype && /usr/bin/npm run x:post -- us_morning >> /var/log/x-post.log 2>&1
